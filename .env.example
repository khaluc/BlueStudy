OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
LLM_TIMEOUT_SECONDS=120
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512
# Use a random URL-safe value (letters/numbers); needed by Docker Compose.
POSTGRES_PASSWORD=replace-with-random-hex-secret
# Optional host-only development settings; Docker uses its internal DB URL.
DATABASE_URL=sqlite:///data/development.db
STORAGE_ROOT=data/uploads
CHAT_BASE_URL=http://127.0.0.1:8001

# Combo A. Add the key locally; never paste it into chat or commit .env.
CHAT_PROVIDER=qwen_cloud
VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct-q8_0
VISION_TIMEOUT_SECONDS=45
DASHSCOPE_API_KEY=sk-ws-H.DHEIXYD.FyjT.MEYCIQDfH2E9_2AW2bDmc1IlZNdxEtKo5dbJieR_MKmZLlOCigIhAPAvqYbAeAGrP7DtymiekunrjMo_Aqdq79TfegDIH20F
QWEN_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-max-0902
QWEN_ENABLE_THINKING=true
QWEN_MAX_TOKENS=4096
CLOUD_TIMEOUT_SECONDS=45
LOCAL_FALLBACK_ENABLED=true
